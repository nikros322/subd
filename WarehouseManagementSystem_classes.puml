@startuml
' ================================
' Class Diagram — Система управления складом
' Автор: Данилов Никита, гр. 24-12
' ================================

skinparam class {
  BackgroundColor #DDEEFF
  BorderColor #336699
  ArrowColor #336699
  FontSize 12
}

' --- Пользователи системы ---
abstract class Пользователь {
  - id: int
  - имя: String
  - логин: String
  - пароль: String
  + войти(): bool
  + выйти(): void
}

class Кладовщик {
  - зона: String
  + принятьТовар(товар: Товар): void
  + отгрузитьТовар(товар: Товар): void
  + переместитьТовар(товар: Товар, место: Место): void
}

class Менеджер {
  - отдел: String
  + создатьЗаказ(поставщик: Поставщик): Заказ
  + сформироватьОтчёт(): Отчёт
  + просмотретьОстатки(): List
}

class Администратор {
  + добавитьПользователя(п: Пользователь): void
  + удалитьПользователя(id: int): void
  + настроитьСистему(): void
}

' --- Товары и склад ---
class Товар {
  - id: int
  - название: String
  - артикул: String
  - количество: int
  - единицаИзмерения: String
  - срокГодности: Date
  + получитьОстаток(): int
  + проверитьСрок(): bool
}

class Склад {
  - id: int
  - адрес: String
  - вместимость: int
  + найтиТовар(артикул: String): Товар
  + получитьСвободноеМесто(): int
}

class Место {
  - номерСекции: String
  - номерПолки: int
  - занято: bool
  + освободить(): void
  + занять(): void
}

' --- Операции ---
class Инвентаризация {
  - дата: Date
  - статус: String
  + начать(): void
  + завершить(): void
  + получитьРасхождения(): List
}

class Заказ {
  - id: int
  - дата: Date
  - статус: String
  - сумма: double
  + подтвердить(): void
  + отменить(): void
}

class Поставщик {
  - id: int
  - название: String
  - контакт: String
  + подтвердитьПоставку(заказ: Заказ): void
}

class Отчёт {
  - дата: Date
  - тип: String
  - данные: String
  + сформировать(): void
  + экспортировать(): void
}

class Уведомление {
  - сообщение: String
  - дата: Date
  - прочитано: bool
  + отправить(): void
}

' --- Наследование ---
Пользователь <|-- Кладовщик
Пользователь <|-- Менеджер
Пользователь <|-- Администратор

' --- Связи ---
Склад "1" *-- "many" Место : содержит
Место "1" o-- "0..1" Товар : хранит
Кладовщик "1" -- "many" Товар : управляет
Менеджер "1" -- "many" Заказ : создаёт
Менеджер "1" -- "many" Отчёт : формирует
Заказ "many" -- "1" Поставщик : отправляется
Инвентаризация "many" -- "1" Склад : проводится на
Инвентаризация ..> Уведомление : создаёт
Заказ ..> Уведомление : создаёт

@enduml
