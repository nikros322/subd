@startuml
left to right direction
skinparam usecase {
  BackgroundColor #DDEEFF
  BorderColor #336699
  ActorBorderColor #333333
}

actor "Кладовщик" as S
actor "Менеджер" as M
actor "Администратор" as A
actor "Поставщик" as P

rectangle "Система управления складом" {
  usecase "Приёмка товара" as UC1
  usecase "Отгрузка товара" as UC2
  usecase "Перемещение товара" as UC3
  usecase "Инвентаризация" as UC4
  usecase "Поиск товара" as UC5
  usecase "Уведомление о нехватке" as UC6
  usecase "Создание заказа поставщику" as UC7
  usecase "Подтверждение поставки" as UC8
  usecase "Просмотр остатков" as UC9
  usecase "Формирование отчёта" as UC10
  usecase "Управление пользователями" as UC11
  usecase "Настройка системы" as UC12
}

S --> UC1
S --> UC2
S --> UC3
S --> UC4
S --> UC5

M --> UC4
M --> UC7
M --> UC9
M --> UC10

A --> UC11
A --> UC12
A --> UC10

P --> UC8

UC7 .> UC6 : "include"
UC4 .> UC9 : "include"
UC5 .> UC6 : "extend"
@enduml
