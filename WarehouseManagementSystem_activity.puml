@startuml
' ================================
' Activity Diagrams — Система управления складом
' Автор: Данилов Никита, гр. 24-12
' ================================
skinparam activity {
  BackgroundColor #DDEEFF
  BorderColor #336699
  ArrowColor #336699
  StartColor #1a237e
  EndColor #1a237e
}
skinparam partitionBackgroundColor #f0f4ff
skinparam partitionBorderColor #336699

' ===== 1. ПРИЁМКА ТОВАРА =====
partition "Приёмка товара" {
  start
  :Поставщик привозит товар;
  :Кладовщик получает накладную;
  if (Накладная корректна?) then (да)
    :Пересчёт товара;
    if (Количество совпадает?) then (да)
      :Проверка качества товара;
      if (Товар без дефектов?) then (да)
        :Разместить товар на складе;
        :Обновить остатки в системе;
        :Подписать накладную;
        :Уведомить менеджера о приёмке;
      else (нет)
        :Составить акт о браке;
        :Вернуть товар поставщику;
      endif
    else (нет)
      :Составить акт расхождения;
      :Уведомить поставщика;
    endif
  else (нет)
    :Отклонить поставку;
    :Уведомить поставщика об ошибке;
  endif
  stop
}

' ===== 2. ОТГРУЗКА ТОВАРА =====
partition "Отгрузка товара" {
  start
  :Получить заявку на отгрузку;
  :Проверить наличие товара в системе;
  if (Товар есть на складе?) then (да)
    :Найти товар по месту хранения;
    :Собрать заказ;
    :Проверить комплектность;
    if (Заказ укомплектован?) then (да)
      :Упаковать товар;
      :Оформить накладную;
      :Передать товар клиенту;
      :Списать товар в системе;
      :Закрыть заявку;
    else (нет)
      :Уведомить менеджера о нехватке;
      :Создать заказ поставщику;
    endif
  else (нет)
    :Отправить уведомление о нехватке;
    :Отложить заявку;
  endif
  stop
}

' ===== 3. ИНВЕНТАРИЗАЦИЯ =====
partition "Инвентаризация" {
  start
  :Менеджер инициирует инвентаризацию;
  :Система выгружает список остатков;
  :Кладовщик обходит склад;
  repeat
    :Сканировать / пересчитать товар;
    :Внести фактическое количество;
  repeat while (Все позиции проверены?) is (нет)
  -> да;
  :Система сравнивает данные;
  if (Есть расхождения?) then (да)
    :Составить акт расхождений;
    if (Недостача?) then (да)
      :Провести служебное расследование;
    else (излишки)
      :Оприходовать излишки;
    endif
    :Скорректировать данные в системе;
  else (нет)
    :Подтвердить корректность остатков;
  endif
  :Закрыть инвентаризацию;
  :Сформировать отчёт;
  stop
}

@enduml
